{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gtrpht-live-hub",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomSignal" },
      { "name": "HUB", "class_name": "HubState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomSignal"] },
    { "tag": "v2", "new_sqlite_classes": ["HubState"] }
  ],
  "observability": { "enabled": true },
  // Public hostnames. The zone bangtaostyle.com is on the same Cloudflare account, so
  // `wrangler deploy` creates the DNS records + certificate itself (no dashboard step).
  "workers_dev": true,
  "routes": [
    { "pattern": "bangtaostyle.com", "custom_domain": true },
    { "pattern": "www.bangtaostyle.com", "custom_domain": true }
  ],
  "vars": {
    "ALLOWED_ROOMS": "gtrpht"
  }
  // Secrets (set in the Cloudflare dashboard → Worker → Settings → Variables & Secrets,
  // or `npx wrangler secret put <NAME>`):
  //   REALTIME_APP_ID, REALTIME_APP_SECRET  — Realtime → SFU → your app
  //   TURN_KEY_ID, TURN_KEY_TOKEN           — Realtime → TURN → your key (optional but recommended)
  //   MAKE_WEBHOOK_URL                      — Make.com Custom Webhook URL (event relay)
  //   CREW_KEY                              — crew passphrase: /camera, /pult, channel editor, GPS push
}
